{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CODING_STANDARDS.md", "CONTRIBUTING.md"],
  "small_model": "anymodel/am/free",
  "provider": {
    "anymodel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "anymodel",
      "options": {
        "baseURL": "https://anymodel.org/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "am/free": {
          "name": "am/free"
        },
        "ds/deepseek-v4-flash": {
          "name": "deepseek-v4-flash-0125cent"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp"
      }
    }
  }
}
